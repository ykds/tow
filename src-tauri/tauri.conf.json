{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Two",
  "version": "0.1.0",
  "identifier": "dev.agentworkspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Two", "width": 1180, "height": 760, "minWidth": 700, "minHeight": 460 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["resources/codex", "resources/codex.cmd", "resources/zsh/.zshenv", "resources/zsh/.zprofile", "resources/zsh/.zshrc", "resources/zsh/.zlogin"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
